public class Main {
    public static void main(String[] args) {
        int idade = 50;

        if (idade <= 12) {
            System.out.println("Criança");
        } else if (idade >= 12 && idade < 18) {
            System.out.println("Adolescente");
        } else if (idade >= 18 && idade < 60) {
            System.out.println("Adulto");
        } else {
            System.out.println("Idoso");
        }
    }
}